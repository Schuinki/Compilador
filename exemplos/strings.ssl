function iguais(s1 : string, s2 : string, n : integer) : boolean
{
    var i : integer;
    i = 0;
    while (i < n && s1[i] == s2[i])
        i = i + 1;
    return i == n;
}

function inverte(s : string, n : integer) : string
{
    var i, j : integer;
    i = 0;
    j = n - 1;
    while (i < j) {
        var c : char;
        c = s[i];
        s[i] = s[j];
        s[j] = c;
        i = i + 1;
        j = j - 1;
    }
    return s;
}
